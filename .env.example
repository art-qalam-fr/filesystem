# Exemple de configuration des répertoires autorisés pour le serveur MCP Filesystem

# Répertoires statiques (jusqu'à 10)
STATIC_ALLOWED_DIR_1=C:/Users/Administrator
STATIC_ALLOWED_DIR_2=C:/Users/Administrator/Desktop
STATIC_ALLOWED_DIR_3=F:/Promgramation-teste
STATIC_ALLOWED_DIR_4=F:/Promgramation-teste/servers

# Dossiers dynamiques (résolus par l'IDE via variables)
MCP_GATEWAY_PATH=${MCP_GATEWAY_PATH}
FILE_WORKSPACE=${FILE_WORKSPACE}
WORKSPACE_1=${WORKSPACE_1}
WORKSPACE_2=${WORKSPACE_2}
WORKSPACE_3=${WORKSPACE_3}
WORKSPACE_4=${WORKSPACE_4}
WORKSPACE_5=${WORKSPACE_5}
WORKSPACE_6=${WORKSPACE_6}
WORKSPACE_7=${WORKSPACE_7}
WORKSPACE_8=${WORKSPACE_8}
WORKSPACE_9=${WORKSPACE_9}
WORKSPACE_10=${WORKSPACE_10}

# Inclure le répertoire courant des processus (optionnel)
MCP_INCLUDE_ACTIVE_ENVS=true

# Ajouter d'autres chemins via une liste séparée par le délimiteur de l'OS
# (par exemple ; sur Windows, : sur Unix)
# MCP_EXTRA_ALLOWED_DIRS=

# Nom du fichier de contexte (optionnel)
LLM_CONTEXT_FILENAME=llm-context
